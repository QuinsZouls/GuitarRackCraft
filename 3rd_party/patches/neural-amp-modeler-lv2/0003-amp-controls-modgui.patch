     background-position:left center;
     background-repeat:no-repeat;
-    background-size:5000px 100px;
-    height:100px;
-    width:100px;
+    /* knob.png is 5000x100: 50 frames of 100x100. Scaled to 3200x64 the frame
+       is exactly the 64x64 element (0.64 on both axes, round(3200/64) = 50
+       frames in modgui_runtime.js), so nothing is cropped or stretched. */
+    background-size:3200px 64px;
+    height:64px;
+    width:64px;
     cursor:pointer;
 }
 
