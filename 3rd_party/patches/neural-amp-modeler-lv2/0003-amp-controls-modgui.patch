     display:inline;
 }
 
-.mod-pedal-nam .group1 {
-    top:86px;
-    left:22px;
+/* Seven knobs in one row across the top band (y 20..98). The 20px gaps above
+   and below keep the row's flow box 118px tall, which is what puts group2's
+   model selector back in the artwork's display window (y 225) as before. */
+.mod-pedal-nam .mod-control-group.group1 {
+    margin:20px 0px;
+    height:78px;
+    display:flex;
+    justify-content:space-evenly;
+    align-items:flex-start;
+}
+
+/* Inside a flex container the base stylesheet's .clearfix ::before/::after
+   become flex items of their own: two empty boxes that take two of
+   space-evenly's gaps, so the knobs sit 11.2px apart with 22.4px of dead space
+   at each end instead of an even 14px. group1 holds no floats and a flex
+   container already contains its items, so drop them. */
+.mod-pedal-nam .group1.clearfix::before,
+.mod-pedal-nam .group1.clearfix::after {
+    display:none;
 }
 
